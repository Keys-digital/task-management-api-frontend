# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Dependencies
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# Testing
**/coverage/

# Next.js
**/.next/
**/out/

# Production builds
**/build/

# Expo / React Native
mobile/.expo/
mobile/dist/
mobile/web-build/

# Expo / React Native native build artifacts
mobile/android/.gradle/
mobile/android/app/build/
mobile/ios/build/

# Environment files
**/.env
**/.env.*
!**/.env.example

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
**/*.tsbuildinfo
**/next-env.d.ts


# Misc
.DS_Store
*.pem


# Vercel
**/.vercel/